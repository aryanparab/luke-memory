# All data stays in .data unless configured otherwise. Never commit that directory.
LUKE_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
LUKE_TEXT_MODEL=gemma2:2b
LUKE_EXTRACTOR=ocr
# Only needed when explicitly selecting LUKE_EXTRACTOR=vision:
LUKE_VISION_MODEL=gemma3:4b
LUKE_PORT=5051
# Capture controls are disabled by default; enabling controls does not start recording.
LUKE_ALLOW_CAPTURE=0
# Set to 1 only to start collection on launch, after allowing capture above.
LUKE_AUTO_CAPTURE=0
# Optional cloud TEXT provider: set LUKE_PROVIDER=groq and LUKE_TEXT_MODEL=openai/gpt-oss-20b.
# Retrieved memory excerpts and questions will then be sent to Groq. No images are sent to Groq.
# GROQ_API_KEY=
